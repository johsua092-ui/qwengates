# Qwen Gate — Environment Variables
# Copy this to .env and customize

# Server
PORT=26405
HOST=0.0.0.0

# API Authentication (optional — leave empty for no auth)
API_KEY=

# Persistent config path (for Railway / cloud volumes)
# CONFIG_PATH=/data/config.json

# Production mode
NODE_ENV=production

# Browser engine: chromium, firefox, webkit, chrome, edge
# BROWSER=chromium

# Qwen accounts from env (useful for Docker / Railway, no file needed)
# Format: email:password
# ACCOUNT1=user1@example.com:password123
# ACCOUNT2=user2@example.com:password456
